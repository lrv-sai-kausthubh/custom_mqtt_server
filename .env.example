# ---------------------------------------------------------------------------
# Web server
# ---------------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Last N entries kept for the admin /logs.html viewer (100-5000).
LOG_BUFFER_LIMIT=1000

# ---------------------------------------------------------------------------
# Local Mosquitto broker
# Keep Mosquitto bound to the laptop/LAN, not the public internet.
# ---------------------------------------------------------------------------
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=server
MQTT_PASSWORD=replace-with-a-long-password

# ---------------------------------------------------------------------------
# ESP32 device gateway (WebSocket + signed HTTP command endpoint)
# DEVICE_WS_TOKEN is shared only with the ESP32 firmware.
# MQTT_INGEST_SECRET is shared only with the Supabase mqtt-dispatch Edge Function.
# ---------------------------------------------------------------------------
DEVICE_WS_PATH=/device
DEVICE_WS_TOKEN=replace-with-a-long-device-token
MQTT_INGEST_SECRET=replace-with-a-long-ingest-secret
DEVICE_HEARTBEAT_MS=15000

# ---------------------------------------------------------------------------
# Supabase (database only - no Supabase Auth and no email)
# Use the server-only key: legacy service_role JWT (eyJ...) or sb_secret_...
# Never put this key in public/ or in the browser.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-only-supabase-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-same-server-only-key
SUPABASE_USERS_TABLE=app_users
SUPABASE_SESSIONS_TABLE=app_sessions
AUTH_SESSION_DAYS=7

# ---------------------------------------------------------------------------
# Cloudflare Quick Tunnel discovery (used by start-tunnel.ps1)
# app_discovery is the canonical row read by the frontend, Edge Function and
# ESP32. device_tunnels is optional/legacy.
# ---------------------------------------------------------------------------
SUPABASE_TUNNEL_TABLE=device_tunnels
SUPABASE_TUNNEL_USER_ID=test_device_one
SUPABASE_DISCOVERY_TABLE=app_discovery

# Optional: if app auth and discovery live in different Supabase projects,
# set these. start-tunnel.ps1 prefers the DISCOVERY_* values over SUPABASE_*.
# DISCOVERY_SUPABASE_URL=https://your-discovery-project.supabase.co
# DISCOVERY_SUPABASE_SERVICE_ROLE_KEY=replace-with-discovery-server-key
# DISCOVERY_TABLE=app_discovery

# ---------------------------------------------------------------------------
# CORS
# "*" is convenient while testing a Vercel preview. Replace it with exact
# origins for production, e.g. https://app.niat.tech,https://your-app.vercel.app
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=*
